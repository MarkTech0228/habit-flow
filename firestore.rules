rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: user must be authenticated ──
    function isAuth() {
      return request.auth != null;
    }

    // ── Helper: user can only access their own data ──
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Helper: validate expense data shape ──
    function validExpense() {
      let data = request.resource.data;
      return data.amount is number
          && data.amount > 0
          && data.amount < 1000000
          && data.description is string
          && data.description.size() <= 200
          && data.category is string;
    }

    // ── Helper: validate habit data ──
    function validHabit() {
      let data = request.resource.data;
      return data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.frequency in ['daily', 'weekly'];
    }

    // ── User document + all subcollections ──
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /habits/{habitId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId) && validHabit();
        allow update: if isOwner(userId) && validHabit();
        allow delete: if isOwner(userId);
      }

      match /todos/{todoId} {
        allow read:          if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;
        allow delete: if isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow read:          if isOwner(userId);
        allow create, update: if isOwner(userId) && validExpense();
        allow delete:         if isOwner(userId);
      }

      match /incomes/{incomeId} {
        allow read:          if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isOwner(userId);
      }

      match /recurringExpenses/{recurringId} {
        allow read:          if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isOwner(userId);
      }

      match /savingsGoals/{goalId} {
        allow read:          if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0;
        allow delete: if isOwner(userId);
      }

      match /debts/{debtId} {
        allow read:          if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.interestRate is number;
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Block everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}